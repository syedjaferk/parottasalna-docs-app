  },
  {
   "id": "el107",
   "type": "text",
   "x": 674,
   "y": 1255.0,
   "width": 398.24,
   "height": 220.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
