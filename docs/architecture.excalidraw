  {
   "id": "el104",
   "type": "text",
   "x": 54,
   "y": 1255.0,
   "width": 416.16,
   "height": 240.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 844846558,
   "version": 1,
   "versionNonce": 1450571438,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "1. Browser → https://learn.parottasalna.com\n   (host Caddy terminates TLS)\n2. Caddy → 127.0.0.1:8000 → nginx container\n3. nginx → Django (gunicorn) at web:8000\n4. Django decides: public (is_common) course?\n   enrolled student? staff? else → login / 403\n5. Allowed → header X-Accel-Redirect:\n   /protected-docs/<slug>/html/<page>\n6. nginx streams the file from docs_build\n   (internal location: no direct URL exists)\n7. progress.js + quiz.js on the page call the\n   JSON APIs back through the same path",
   "originalText": "1. Browser → https://learn.parottasalna.com\n   (host Caddy terminates TLS)\n2. Caddy → 127.0.0.1:8000 → nginx container\n3. nginx → Django (gunicorn) at web:8000\n4. Django decides: public (is_common) course?\n   enrolled student? staff? else → login / 403\n5. Allowed → header X-Accel-Redirect:\n   /protected-docs/<slug>/html/<page>\n6. nginx streams the file from docs_build\n   (internal location: no direct URL exists)\n7. progress.js + quiz.js on the page call the\n   JSON APIs back through the same path",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
