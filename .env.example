# Copy to .env and fill in. Never commit .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Shown on the privacy policy for data requests (needed for Google OAuth verification)
CONTACT_EMAIL=

# Anyone with a Google account may sign up (default true). false = only enrolled emails.
# OPEN_SIGNUP=true

# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Blog (Obsidian vault, imported with: python manage.py import_blog)
# BLOG_SRC_ROOT=/path/to/second-brain        # local runs
# BLOG_SOURCE_DIR=/opt/second-brain           # docker compose: host folder mounted into the app
# BLOG_WORDPRESS_URL=                         # empty = blog fully independent of WordPress
# BLOG_CANONICAL_TO_WORDPRESS=true            # while WordPress is set, point search engines at it

# Docker compose (docker-compose.yml sets DATABASE_URL, paths and X-Accel for you)
# POSTGRES_PASSWORD=change-me
# HTTP_PORT=8000                 # host port Nginx listens on
# BUILD_DOCS_ON_START=true       # rebuild all courses when the web container starts
# SECURE_SSL_REDIRECT=false      # with DEBUG=false over plain HTTP (no TLS in front)
# SECURE_COOKIES=false           # same; keep true in real production behind HTTPS

# Optional
# DATABASE_URL=postgres://user:pass@localhost:5432/portal
# COURSES_SRC_ROOT=/srv/portal/course_content
# DOCS_BUILD_ROOT=/srv/portal/docs_build
# USE_X_ACCEL_REDIRECT=true      # production behind Nginx
# ACCOUNT_DEFAULT_HTTP_PROTOCOL=https  # scheme of the Google callback URL when DEBUG=false (default https)
# SECURE_HSTS_SECONDS=31536000

# Admin panel: show upcoming Calendly calls. Personal access token from
# Calendly → Integrations → API & Webhooks, with scopes users:read and scheduled_events:read.
# Leave empty to hide calls.
CALENDLY_TOKEN=

# Resume ATS review (/resume-review/). PDFs are uploaded to a Google Drive folder, never kept here.
# Credentials: a service-account key (the folder must be on a shared drive the account is a member of)
# or an OAuth authorized_user token. In docker compose, put it in ./secrets/ (mounted at /app/secrets).
GDRIVE_CREDENTIALS_FILE=
RESUME_DRIVE_FOLDER_ID=
# Shared secret for the review worker (resumes/api.py). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATS_WORKER_TOKEN=
# RESUME_RETENTION_DAYS=7       # days after the report email before the PDF is deleted from Drive

# Email (the separate mailer: listmonk, see ../mailer/README.md). Empty = no emails.
# Same server: also set COMPOSE_FILE so the web container joins the mailer's network.
# COMPOSE_FILE=docker-compose.yml:docker-compose.mailer.yml
MAILER_URL=
MAILER_API_USER=
MAILER_API_TOKEN=
MAILER_TEMPLATE_ID=
# SITE_URL=https://learn.parottasalna.com   # used for links in emails

# Sign-in emails (verification + password reset for email/password accounts). Empty EMAIL_HOST = printed to the console.
EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Parottasalna <no-reply@parottasalna.com>

# Payments (Pro membership and live-batch seats). Razorpay dashboard > Account & Settings > API keys.
# Webhook: https://<your-domain>/billing/webhook/ for the payment.captured and order.paid events.
# Leave empty and the pricing page says payments are not open yet.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
