   "versionNonce": 1559020773,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "- Most features, higher price\n- API keys, usage plans, per-method throttling\n- Request validation, mapping templates (VTL)\n- Caching, WAF, canary, resource policies\n- Edge, Regional or Private endpoints\n\nUse for: public APIs needing control,\ntransformation, direct AWS service integrations",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "- Most features, higher price\n- API keys, usage plans, per-method throttling\n- Request validation, mapping templates (VTL)\n- Caching, WAF, canary, resource policies\n- Edge, Regional or Private endpoints\n\nUse for: public APIs needing control,\ntransformation, direct AWS service integrations",
   "autoResize": true,
   "lineHeight": 1.25
  },
