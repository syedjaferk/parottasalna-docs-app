   "locked": false,
   "text": "- 400: validator or bad body\n- 401: authorizer raised Unauthorized\n- 403: Deny policy, missing API key, WAF; REST also uses 403 'Missing\nAuthentication Token' for unknown routes\n- 404: no route (HTTP API)\n- 415: passthrough NEVER with no template\n- 429: throttled\n- 502: malformed Lambda response\n- 504: integration timeout (29 s)",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "- 400: validator or bad body\n- 401: authorizer raised Unauthorized\n- 403: Deny policy, missing API key, WAF; REST also uses 403 'Missing\nAuthentication Token' for unknown routes\n- 404: no route (HTTP API)\n- 415: passthrough NEVER with no template\n- 429: throttled\n- 502: malformed Lambda response\n- 504: integration timeout (29 s)",
   "autoResize": true,
   "lineHeight": 1.25
