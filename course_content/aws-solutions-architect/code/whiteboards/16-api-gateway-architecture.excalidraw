   "link": null,
   "locked": false,
   "text": "- 400 Invalid request body: validator, Lambda never ran\n- 403 Forbidden: API key missing or not in the usage plan\n- 429 Too Many Requests: stage or plan throttle\n- 404: item id not found (from Lambda)\n- 502: Lambda response missing statusCode or body",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "- 400 Invalid request body: validator, Lambda never ran\n- 403 Forbidden: API key missing or not in the usage plan\n- 429 Too Many Requests: stage or plan throttle\n- 404: item id not found (from Lambda)\n- 502: Lambda response missing statusCode or body",
   "autoResize": true,
   "lineHeight": 1.25
  },
