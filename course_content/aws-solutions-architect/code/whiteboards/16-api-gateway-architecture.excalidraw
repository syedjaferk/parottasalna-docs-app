   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "- Cheapest, lowest latency\n- Lambda or HTTP proxy, VPC Link\n- JWT, IAM or Lambda authorizer\n- CORS built in, auto-deploy ($default stage)\n- No API keys, validation, caching or canary\n\nUse for: simple proxy APIs to Lambda or HTTP\nbackends",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "- Cheapest, lowest latency\n- Lambda or HTTP proxy, VPC Link\n- JWT, IAM or Lambda authorizer\n- CORS built in, auto-deploy ($default stage)\n- No API keys, validation, caching or canary\n\nUse for: simple proxy APIs to Lambda or HTTP\nbackends",
   "autoResize": true,
   "lineHeight": 1.25
  },
