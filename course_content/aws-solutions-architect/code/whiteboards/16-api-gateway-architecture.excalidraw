   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "- IAM (SigV4): service-to-service calls\n- Cognito user pool or JWT authorizer: user login (JWT is for HTTP API)\n- Lambda authorizer: custom tokens and logic\n- Resource policy: IP allow-list, cross-account\n- API key: metering only, never security\n- WAF and mutual TLS for extra protection",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "- IAM (SigV4): service-to-service calls\n- Cognito user pool or JWT authorizer: user login (JWT is for HTTP API)\n- Lambda authorizer: custom tokens and logic\n- Resource policy: IP allow-list, cross-account\n- API key: metering only, never security\n- WAF and mutual TLS for extra protection",
   "autoResize": true,
   "lineHeight": 1.25
  },
