   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "- Persistent two-way connection\n- Route chosen from the message body\n($request.body.action)\n- $connect, $disconnect, $default routes\n- Server pushes through the @connections endpoint\n- You store connectionIds (DynamoDB)\n\nUse for: chat, live dashboards, notifications, games",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "- Persistent two-way connection\n- Route chosen from the message body\n($request.body.action)\n- $connect, $disconnect, $default routes\n- Server pushes through the @connections endpoint\n- You store connectionIds (DynamoDB)\n\nUse for: chat, live dashboards, notifications, games",
   "autoResize": true,
   "lineHeight": 1.25
  },
