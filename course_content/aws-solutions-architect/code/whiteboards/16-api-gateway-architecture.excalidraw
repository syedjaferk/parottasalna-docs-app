  },
  {
   "id": "ewhxx19pd8us2",
   "type": "text",
   "x": 56,
   "y": 6307.5,
   "width": 828,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1662963862,
   "version": 1,
   "versionNonce": 614283837,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "1. Client opens wss://.../production?name=Asha: $connect stores the connectionId.\n2. Client sends {\"action\":\"sendmessage\",\"message\":\"hi\"}: route sendmessage.\n3. Lambda scans the connections table and pushes to every connectionId.\n4. A 410 GoneException means the client left: delete that row.\n5. Client closes: $disconnect deletes the row.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "1. Client opens wss://.../production?name=Asha: $connect stores the connectionId.\n2. Client sends {\"action\":\"sendmessage\",\"message\":\"hi\"}: route sendmessage.\n3. Lambda scans the connections table and pushes to every connectionId.\n4. A 410 GoneException means the client left: delete that row.\n5. Client closes: $disconnect deletes the row.",
   "autoResize": true,
   "lineHeight": 1.25
  },
