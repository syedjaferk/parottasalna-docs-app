  {
   "id": "e4wfhcz8fj2j1",
   "type": "text",
   "x": 956,
   "y": 6307.5,
   "width": 788,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 210679803,
   "version": 1,
   "versionNonce": 1292937437,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "- API Gateway holds the connections; Lambda is stateless, so you store the IDs.\n- Lambda needs execute-api:ManageConnections.\n- Push URL is https://domain/stage, not wss://.\n- Max 2 hours per connection, 10 minutes idle.\n- Messages without an action field go to $default.\n- Add an authorizer on $connect for real apps.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "- API Gateway holds the connections; Lambda is stateless, so you store the IDs.\n- Lambda needs execute-api:ManageConnections.\n- Push URL is https://domain/stage, not wss://.\n- Max 2 hours per connection, 10 minutes idle.\n- Messages without an action field go to $default.\n- Add an authorizer on $connect for real apps.",
   "autoResize": true,
   "lineHeight": 1.25
  },
