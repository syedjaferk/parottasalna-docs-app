  {
   "id": "e4096q80a7fml",
   "type": "text",
   "x": 56,
   "y": 5227.5,
   "width": 828,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1645126055,
   "version": 1,
   "versionNonce": 2119541174,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "text": "1. Client POSTs JSON to /orders.\n2. Validator checks it against OrderModel (400 if bad).\n3. The VTL template turns JSON into SQS's form-encoded SendMessage call.\n4. API Gateway assumes the execution role and calls SQS directly: no Lambda.\n5. SQS replies with XML; a response template returns {\"status\":\"queued\"}.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "1. Client POSTs JSON to /orders.\n2. Validator checks it against OrderModel (400 if bad).\n3. The VTL template turns JSON into SQS's form-encoded SendMessage call.\n4. API Gateway assumes the execution role and calls SQS directly: no Lambda.\n5. SQS replies with XML; a response template returns {\"status\":\"queued\"}.",
   "autoResize": true,
   "lineHeight": 1.25
  },
