      "text": "Authentication & Security\n\nVerify JWT/API keys once at\nthe edge, so every service\ndoesn't re-implement it.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "e62",
      "originalText": "Authentication & Security\n\nVerify JWT/API keys once at\nthe edge, so every service\ndoesn't re-implement it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b00",
