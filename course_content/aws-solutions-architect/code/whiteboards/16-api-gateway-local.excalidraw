      "updated": 1791039290342,
      "link": null,
      "locked": false,
      "text": "Single entry point\n\nOne URL for all services.\nClients don't need to know\nservice addresses/ports.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "e58",
      "originalText": "Single entry point\n\nOne URL for all services.\nClients don't need to know\nservice addresses/ports.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aw",
