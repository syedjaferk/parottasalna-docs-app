oundElements": [{"type": "text", "id": "el130"}], "updated": 1, "link": null, "locked": false}, {"id": "el130", "type": "text", "x": 1528.4, "y": 1100.0, "width": 123.20000000000002, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 681192098, "version": 1, "versionNonce": 270859704, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Similarity\nsearch (top-k)", "originalText": "Similarity\nsearch (top-k)", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "el129", "lineHeight": 1.25, "autoResize": true, "baseline": 16}, {"id": "el131", "type": "arrow", "x": 1590, "y": 1010, "width": 0, "height": 80, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 373006685, "version": 1, "versionNonce": 646692356, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [0, 80]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "el132", "type": "rectangle", "x": 1270, "y": 1195, "width": 300, "height": 56, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 391017515, "version": 1, "versionNonce": 509116261, "isDeleted": false, "boundElements": [{"type": "text", "id": "el133"}], "updated": 1, "link": null, "locked": false}, {"id": "el133", "type": "text", "x": 1270.4, "y": 1213.0, "width": 299.20000000000005, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 131900843, "version": 1, "versionNonce": 123859889, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Prompt = top-k memories + question", "originalText": "Prompt = top-k memories + question", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "el132", "lineHeight": 1.25, "autoResize": true, "baseline": 16}, {"id": "el134", "type": "arrow", "x": 1590, "y": 1150, "width": 100, "height": 45, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 911539082, "version": 1, "versionNonce": 524059082, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [-100, 45]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "el135", "type": "text", "x": 1180, "y": 1270, "width": 445.50000000000006, "height": 93.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 500352374, "version": 1, "versionNonce": 515820315, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Every message is embedded and stored; for each new\nquestion only the most similar memories are retrieved.\n+ Scales to huge history, recalls by meaning\n- Needs embeddings + vector DB; may miss context\nBest for: large knowledge or long-lived agents.", "originalText": "Every message is embedded and stored; for each new\nquestion only the most similar memories are retrieved.\n+ Scales to huge history, recalls by meaning\n- Needs embeddings + vector DB; may miss context\nBest for: large knowledge or long-lived agents.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true, "baseline": 15}, {"id": "el136", "type": "text", "x": 0, "y": 1510, "width": 200.20000000000002, "height": 35.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 519513507, "version": 1, "versionNonce": 334848880, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Quick compare", "originalText": "Quick compare", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true, "baseline": 28}, {"id": "el137", "type": "text", "x": 0, "y": 1555, "width": 702.9000000000001, "height": 135.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 92217960, "version": 1, "versionNonce": 154744983, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Buffer    : all messages          -> exact, but grows without limit\nWindow    : last k turns          -> cheap, forgets older chat\nToken     : last N tokens         -> cheap, precise size control\nSummary   : compressed history    -> long chats, may lose details\nLong-term : saved facts on disk   -> survives restarts\nSemantic  : vector similarity     -> retrieves relevant past by meaning", "originalText": "Buffer    : all messages          -> exact, but grows without limit\nWindow    : last k turns          -> cheap, forgets older chat\nToken     : last N tokens         -> cheap, precise size control\nSummary   : compressed history    -> long chats, may lose details\nLong-term : saved facts on disk   -> survives restarts\nSemantic  : vector similarity     -> retrieves relevant past by meaning", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true, "baseline": 18}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}