   "link": null,
   "locked": false,
   "text": "Flow\n1. Client spawns `python mcp_server.py` over stdio\n2. get_tools() discovers: add, reverse_text\n3. LLM calls add(21, 21)  ->  42\n4. LLM calls reverse_text('parottasalna')  ->  'anlasattorap'\n5. LLM writes the final answer to the user",
   "originalText": "Flow\n1. Client spawns `python mcp_server.py` over stdio\n2. get_tools() discovers: add, reverse_text\n3. LLM calls add(21, 21)  ->  42\n4. LLM calls reverse_text('parottasalna')  ->  'anlasattorap'\n5. LLM writes the final answer to the user",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e62",
   "lineHeight": 1.25,
   "autoResize": true
  }
