# Copy this file to .env and fill in YOUR values. Never share the real .env file.
LLM_API_KEY=paste-your-ai-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# A bigger model for hard messages (optional; if you leave it out, the cheap model is used for everything)
LLM_STRONG_MODEL=llama-3.3-70b-versatile

TELEGRAM_BOT_TOKEN=paste-your-bot-token-here
# Your own Telegram user id (a number). Only you may use /stats.
TELEGRAM_ADMIN_ID=123456789
# Where the daily summary is sent. For a private chat with the bot this is the same number as your user id.
TELEGRAM_ADMIN_CHAT=123456789
